# -----------------------------------------------------------------------------
# Job Harvester environment template
# Copy this file to .env (or .env.dev) and fill in real values.
# -----------------------------------------------------------------------------

# Brightdata API
BRAVE_API_KEY=
BRIGHTDATA_API_KEY=

# Brave discovery tuning
BRAVE_API_BASE=https://api.search.brave.com/res/v1/web/search
BRAVE_RATE_LIMIT_MAX_RETRIES=3
BRAVE_RATE_LIMIT_BASE_DELAY_MS=2000
# Comma-separated queries used by 01-discover.ts
BRAVE_QUERIES=software engineer jobs Switzerland,full stack developer jobs Switzerland,CTO jobs Switzerland

# LinkedIn discovery
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
LINKEDIN_PROFILE_DIR=./linkedin-profile
# Comma-separated terms used for LinkedIn job search
LINKEDIN_SEARCH_TERMS=CTO,Solution Architect,Software Engineering Manager
# Comma-separated locations used for LinkedIn job search
LINKEDIN_LOCATIONS=Zurich

# Gmail + Google Drive service-account auth (Domain-Wide Delegation)
# JSON string for the full service account key object
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

# Delegated users (can be different)
GOOGLE_GMAIL_IMPERSONATED_USER=
GOOGLE_DRIVE_IMPERSONATED_USER=

# Gmail behavior
GMAIL_LABEL=
GMAIL_MARK_AS_READ=false
GMAIL_MAX_RESULTS=40

# Google Drive target folder
GOOGLE_DRIVE_FOLDER_ID=

# OneDrive upload token
ONEDRIVE_ACCESS_TOKEN=

# Required runtime output root for all pipeline files (used by all scripts)
JOB_HARVESTER_WORK_DIR=./data

# Optional runtime management-data root for operator-managed inputs/state files
# Contains: applied-companies.txt, cv-keywords.md, job-search-processed.json
JOB_HARVESTER_MANAGEMENT_DATA_DIR=.
