# -----------------------------------------------------------------------------
# Job Harvester environment template
# Copy this file to .env (or .env.dev) and fill in real values.
# -----------------------------------------------------------------------------

# Brightdata API
BRAVE_API_KEY=
BRIGHTDATA_API_KEY=

# LinkedIn discovery
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=
LINKEDIN_PROFILE_DIR=./linkedin-profile

# Gmail + Google Drive service-account auth (Domain-Wide Delegation)
# JSON string for the full service account key object
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

# Delegated users (can be different)
GOOGLE_GMAIL_IMPERSONATED_USER=
GOOGLE_DRIVE_IMPERSONATED_USER=

# Gmail behavior
GMAIL_MARK_AS_READ=false

# Google Drive target folder
GOOGLE_DRIVE_FOLDER_ID=

# OneDrive upload token
ONEDRIVE_ACCESS_TOKEN=

# Optional runtime data directory override
# JOB_HARVESTER_DATA_DIR=./data
